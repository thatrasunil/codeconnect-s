# Production Environment Variables
# These will be OVERRIDDEN by Vercel environment variables
# This file serves as documentation only

# Backend API URL - SET THIS IN VERCEL DASHBOARD
REACT_APP_BACKEND_URL=https://codeconnect-backend-red.vercel.app
REACT_APP_SOCKET_URL=https://codeconnect-backend-red.vercel.app

# Note: Firebase config is hardcoded in src/firebase.js
# If you want to use different Firebase projects for dev/prod,
# you would need to use environment variables there too
